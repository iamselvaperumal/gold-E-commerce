
# Customer-only voice product search
# Install backend requirements first so faster-whisper is available.
VOICE_SEARCH_ENABLED=true
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
VOICE_MAX_FILE_SIZE_MB=10
VOICE_MAX_DURATION_SECONDS=30
VOICE_DEFAULT_LANGUAGE=ta
VOICE_SUPPORTED_LANGUAGES=ta,en
VOICE_TRANSLATE_TO_ENGLISH=false
VOICE_MIN_INTENT_CONFIDENCE=0.60
VOICE_WEIGHT_TOLERANCE_GRAMS=0.5
VOICE_RESULT_LIMIT=20
